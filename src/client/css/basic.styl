@require './includes'
@require './includes/theme'

body
  overflow hidden
  background var(--main)
  font-size 12px
  line-height 1.5715
  font-family -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'
  font-variant: tabular-nums
  color var(--text)

::-webkit-scrollbar
  background transparent
  width 7px

.term-wrap:hover
  ::-webkit-scrollbar
    width 12px

::-webkit-scrollbar-track
  -webkit-box-shadow none

::-webkit-scrollbar-thumb
  background-color var(--primary)
  outline none

::-webkit-scrollbar-corner
  background-color transparent

.common-err
  max-height 100px
  overflow-y scroll
  overflow-x hidden
  word-break break-all

a
  color var(--text)
  &:hover
    color var(--text-dark)

.cap
  text-transform capitalize

// shared drag-and-drop reorder indicators (vertical lists)
// first half of the target  => insert before => top edge
// second half of the target => insert after  => bottom edge
// (tabs use their own horizontal left/right line indicators)
.dnd-before
  box-shadow inset 0 2px 0 0 var(--primary)
.dnd-after
  box-shadow inset 0 -2px 0 0 var(--primary)
// antd table rows: box-shadow on <tr> is not rendered, apply on cells
tr.dnd-before > td
  box-shadow inset 0 2px 0 0 var(--primary)
tr.dnd-after > td
  box-shadow inset 0 -2px 0 0 var(--primary)

.sync-data-compare
  .sync-suggest-action
    color var(--success)
    font-weight 500

// ---- FinalShell-style dense overrides ----
.tab
  font-size 12px
  padding 0 10px
  min-width 88px
  letter-spacing 0
  &.active
    box-shadow inset 0 2px 0 0 var(--primary)
    font-weight 600

// slimmer sidebar tree rows
.sidebar
  .ant-tree
    font-size 12px
  .ant-tree .ant-tree-treenode
    padding 1px 0
  .ant-tree .ant-tree-node-content-wrapper
    line-height 22px
    min-height 22px

// bookmark list rows
.bookmark-item
  font-size 12px

// footer batch input: FinalShell-like prominent command box
.batch-input-holder
  .bi-full
    input, textarea
      background var(--main-dark)
      border 1px solid var(--main-lighter)
      border-radius 3px
      font-size 12px
      &:focus
        border-color var(--primary)

// remote monitor bar dense
.remote-monitor-bar
  font-size 11px
  background var(--main-dark)

// top toolbar (FinalShell-style)
.finalshell-toolbar
  display flex
  align-items center
  gap 4px
  height 34px
  padding 0 10px
  background var(--main-dark)
  border-bottom 1px solid var(--main-darker)
  .ant-btn
    height 26px
    padding 0 10px
    font-size 12px
    background transparent
    border-color transparent
    color var(--text)
    box-shadow none
    &:hover, &:focus
      background var(--main-light)
      border-color transparent
      color var(--text-light)
    &.is-active
      background var(--main-light)
      color var(--primary)
      border-color transparent