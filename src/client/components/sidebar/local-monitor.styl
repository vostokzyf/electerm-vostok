// 本机监控 — FinalShell-style compact panel at the bottom of the left sidebar
.local-monitor
  position absolute
  left 0
  right 0
  bottom 0
  z-index 210
  background var(--main-dark)
  border-top 1px solid var(--main-lighter)
  font-size 12px
  color var(--text)
  .lm-head
    display flex
    align-items center
    justify-content space-between
    height 32px
    padding 0 10px
    cursor pointer
    user-select none
    &:hover
      background rgba(255,255,255,.03)
    .lm-title
      font-weight 600
      font-size 12px
  .lm-body
    max-height 170px
    overflow-y auto
    padding 0 10px 8px
  .lm-row
    display flex
    align-items center
    gap 8px
    min-height 26px
    padding 2px 0
  .lm-row-slim
    min-height 22px
  .lm-label
    width 32px
    flex none
    color var(--text-dark)
    font-size 12px
  .lm-bar
    flex 1
    min-width 30px
    height 4px
    border-radius 2px
    background rgba(255,255,255,.09)
    overflow hidden
  .lm-bar-fill
    height 100%
    border-radius 2px
    background var(--primary)
    transition width .6s ease
  .lm-val
    flex none
    font-family ui-monospace, SFMono-Regular, Consolas, monospace
    font-size 11px
    color var(--text)
    white-space nowrap
  .lm-gpu
    margin-top 2px
    padding-top 4px
    border-top 1px dashed var(--main-lighter)
  .lm-gpu-name
    font-size 11px
    color var(--text-dark)
    white-space nowrap
    overflow hidden
    text-overflow ellipsis
    padding 2px 0

// reserve space: keep the bookmarks list from scrolling under the monitor
.sidebar-list
  &:has(.local-monitor.expanded) .sidebar-panel
    bottom 202px
  &:has(.local-monitor.collapsed) .sidebar-panel
    bottom 32px
